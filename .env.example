# Select the default OpenAI provider and model.
# AGENT_MODEL_PROVIDER=openai
# AGENT_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Use a local Ollama model through Ollama's OpenAI-compatible API.
AGENT_MODEL_PROVIDER=ollama
AGENT_MODEL_NAME=llama3.2:3b

# These values are optional for a standard local Ollama installation.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama